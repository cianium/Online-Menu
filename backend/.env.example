# Copy to backend/.env — never commit the real file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string. Use a unique strong password and a managed database in production.
DATABASE_URL=postgres://romano:change-me-in-dev@localhost:5432/romano

SESSION_TTL_SECONDS=604800

# Cookies are Secure by default in production. "false" is honoured ONLY when NODE_ENV is not production
# (plain-http local development).
COOKIE_SECURE=false

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx/Caddy/Cloudflare tunnel).
# Leave "false" when the app is exposed directly, otherwise clients could spoof their IP and dodge rate limits.
TRUST_PROXY=false

# Where uploaded images are stored. Put this on a persistent volume (or move to object storage later).
UPLOAD_DIR=./uploads

# Used once by `npm run seed`. There is intentionally NO default password; it must be >= 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=ROMANO Owner

# --- Automatic translation of admin content into fa / en / tr / ar ---------------------------------
# Leave ANTHROPIC_API_KEY empty to turn it off (content then stays in the language it was typed in).
# The key lives ONLY on the server; never put it in the browser or commit it.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-sonnet-5-5
# Hard cap on translation jobs started by one save (protects against runaway cost).
MAX_TRANSLATIONS_PER_REQUEST=100
# Set to "false" to disable even when a key is present.
AUTO_TRANSLATE=true
