{
  "name": "online-menu-vq3",
  "version": "3.0.0",
  "private": true,
  "description": "RAMEN multilingual digital menu, QR ordering and restaurant operations workspace",
  "scripts": {
    "demo": "node qa/demo-server.mjs",
    "demo:export": "node qa/export-demo.mjs",
    "qa:demo": "node --test qa/demo-server.test.mjs qa/api-client.test.mjs qa/export-demo.test.mjs",
    "qa:demo-browser": "node qa/demo-browser.test.cjs",
    "qa:static": "node qa/static-audit.mjs",
    "qa:syntax": "node qa/syntax-audit.mjs",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:seed": "npm --prefix backend run seed",
    "test": "node --experimental-strip-types --test backend/test/*.test.mjs",
    "qa": "npm run qa:static && npm test && npm run qa:demo",
    "qa:db": "sh qa/commerce-db.test.sh",
    "backend:migrate": "npm --prefix backend run migrate",
    "qa:browser": "node qa/admin-browser.test.cjs",
    "qa:customer": "node qa/customer-browser.test.cjs",
    "qa:production": "node qa/production-preflight.mjs"
  }
}
